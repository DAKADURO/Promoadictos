// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Offer {
  id            String   @id @default(cuid())
  title         String
  description   String?
  price         Float
  originalPrice Float?
  discount      Int?
  imageUrl      String
  affiliateUrl  String
  category      String   @default("General")
  brand         String?
  isFeatured    Boolean  @default(false)
  isActive      Boolean  @default(true)
  lastCheckedAt DateTime?
  failedChecks  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  priceHistories PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(cuid())
  offerId   String
  price     Float
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model Coupon {
  id           String    @id @default(cuid())
  title        String
  code         String    // Ej: "MELI100" o "N/A" para automáticos
  discount     String?   // Ej: "10%", "$100 MXN", "Envío gratis"
  description  String?
  store        String    // Ej: "Mercado Libre", "Amazon", "AliExpress"
  link         String
  category     String    @default("General")
  expiryDate   DateTime?
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Single-row table holding the OAuth tokens for our Mercado Libre app.
// Needed since ML now requires Authorization: Bearer <token> for the
// public items/search resources (see AGENTS.md/PLAN.md Phase 3 notes).
model MercadoLibreToken {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model JobLog {
  id        String   @id @default(cuid())
  job       String   // Nombre del job: "sync-prices", "check-links", etc.
  startedAt DateTime @default(now())
  endedAt   DateTime?
  result    Json?    // Resultado JSON del job
  error     String?  // Mensaje de error si falló
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([job])
  @@index([createdAt])
}
