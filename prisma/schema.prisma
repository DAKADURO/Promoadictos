// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Offer {
  id            String   @id @default(cuid())
  title         String
  description   String?
  price         Float
  originalPrice Float?
  discount      Int?
  imageUrl      String
  affiliateUrl  String
  category      String   @default("General")
  brand         String?
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Coupon {
  id           String    @id @default(cuid())
  title        String
  code         String    // Ej: "MELI100" o "N/A" para automáticos
  discount     String?   // Ej: "10%", "$100 MXN", "Envío gratis"
  description  String?
  store        String    // Ej: "Mercado Libre", "Amazon", "AliExpress"
  link         String
  category     String    @default("General")
  expiryDate   DateTime?
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
